// VERA Prisma schema v3 — Enterprise-grade with auth, audit, profile
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============= USER & AUTH =============
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // TODO: Migration required - currently stores plain text, must run migration script to hash existing passwords with bcryptjs before deploying HMAC-signed auth
  name      String
  role      String   @default("reviewer") // "admin" | "reviewer" | "supervisor" | "medical_officer"
  avatar    String?  // initials or URL
  department String? // "Audit" | "Medical Review" | "Compliance"
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  uploadedEpisodes Episode[] @relation("UploadedBy")
  overriddenEpisodes AuditLog[] @relation("OverriddenBy")
}

// ============= EPISODES & LAB DATA =============
model Episode {
  id            String   @id @default(cuid())
  caseId        String   @unique
  diseaseCode   String   // ICD-10, e.g. "J18.9"
  diseaseName   String   // "Pneumonia"
  admitDay      String   @default("H1")
  claimedDays   Int      // e.g. 7
  actualDays    Int?
  emrTextRaw    String   // raw EMR text (PHI included, never exposed)
  emrTextStrip  String   // stripped text sent to LLM (no PHI)
  status        String   @default("pending") // "pending" | "analyzed" | "flagged" | "audited" | "extraction_failed"
  deviationScore Float?  @default(0)
  flagLevel     String?  // "LOW" | "MEDIUM" | "HIGH"
  extractionBackend String? // "openrouter" | "zai" | "regex"
  uploadedById  String?
  uploadedBy    User?    @relation("UploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  labData       LabData[]
  auditLogs     AuditLog[]
}

model LabData {
  id          String   @id @default(cuid())
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  dayLabel    String   // "H1", "H2", ... "H7"
  leukosit    Float?
  trombosit   Float?
  tdSistol    Float?
  tdDiastol   Float?
  suhu        Float?
  gcs         Int?
  createdAt   DateTime @default(now())
}

// ============= AUDIT TRAIL =============
model AuditLog {
  id          String   @id @default(cuid())
  episodeId   String?
  episode     Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // "login" | "logout" | "viewed_case" | "flagged" | "overridden" | "evidence_exported" | "uploaded" | "settings_changed"
  reason      String?  // medical reason for override
  metadata    String?  // JSON string
  overriddenById String?
  overriddenBy User?    @relation("OverriddenBy", fields: [overriddenById], references: [id])
  createdAt   DateTime @default(now())
}

// ============= SYSTEM SETTINGS =============
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique // "deviation_threshold_high" | "recommended_discharge_pneumonia" | etc
  value       String   // stored as string, parsed by type per key
  category    String   @default("threshold") // "threshold" | "disease" | "general"
  updatedAt   DateTime @updatedAt
  updatedById String?
}
